# Server Port Configuration
PORT=5000

# Connection Strings (Replace with your local or Atlas cluster URI)
MONGO_URI=mongodb+srv://<username>:<password>@your-cluster.mongodb.net/ngo_db?retryWrites=true&w=majority

# JWT Token Secret for Signings (Use a strong unique random string locally)
JWT_SECRET=your_jwt_secret_key_here

# Client URL (for CORS setup, matching the React/Vite dev server)
CLIENT_URL=http://localhost:5173

# Cloudinary Integration (Required for Image/PDF Uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret
